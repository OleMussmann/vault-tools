#!/usr/bin/env bash
# stack — check for and apply image updates for this stack's services.
#
# Runs on the workstation, not in a container.
# Requires: incus-compose, incus, curl, jq, git.
#
# Expects, in STACK_DIR:
#   compose.yaml   with  name: hermes
#                  and   image: nousresearch/hermes-agent:${HERMES_TAG}
#                  and   image: syncthing/syncthing:${SYNCTHING_TAG}  (if used)
#   .env           with  HERMES_TAG=v2026.7.30
#                  and   SYNCTHING_TAG=2.1.2                          (if used)
#
# .env holds version pins only — Hermes reads its API keys from
# /opt/data/.env inside the volume, so this file is safe to commit.
#
# Two known services, hermes and syncthing — see service_config() below.
# Five things vary per service (registry repo, tag-pattern regex, .env
# variable, volume to snapshot, version command); everything dangerous
# (the --pull always no-op trap, snapshot-then-verify) is shared. Adding a
# third service means adding one case arm, not a plugin architecture.
#
# Verified 2026-07-31 (hermes) and 2026-08-02 (syncthing) against
# incus-compose on IncusOS. See IMPLEMENTATION.md for the test results this
# encodes, including confirmation that `--recreate <service>` actually
# scopes — recreating hermes left a running syncthing sidecar's uptime
# completely undisturbed.
#
# Config from the environment, never guessed:
#   STACK_DIR   path to the directory holding compose.yaml/.env (required)
#
# STACK_DIR must be explicit, not self-detected from the script's own
# location — as a vault-tools package this file runs from the Nix store, not
# from inside the stack directory it operates on.

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage:
  stack check                    compare pinned tags against upstream, all known services
  stack check <service>          same, scoped to one service
  stack update <service> <tag>   snapshot, pin, recreate, verify
  stack --help                   this text

known services: hermes, syncthing

config (environment, not the repo):
  STACK_DIR         path to the directory holding compose.yaml/.env (required)
  INCUS_POOL        storage pool (default: local)
  INCUS_PROJECT     incus project (default: detected from compose.yaml's name:)
  HERMES_VOLUME     hermes's custom volume name (default: vol-hermes-data)
  SYNCTHING_VOLUME  syncthing's custom volume name (default: vol-syncthing-config)
EOF
}

# --help/-h must work without STACK_DIR set, so this check comes before the
# `:?` below rather than living only in the final case statement.
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac

STACK_DIR="${STACK_DIR:?set STACK_DIR to the path of your hermes stack directory}"
ENV_FILE="$STACK_DIR/.env"
COMPOSE_FILE="$STACK_DIR/compose.yaml"
KNOWN_SERVICES=(hermes syncthing)

# Confirmed on IncusOS: pool is `local` (zfs), and incus-compose names custom
# volumes vol-<compose-volume>, scoped to a project named after the compose
# project. Verify with: incus --project <p> storage volume list <pool>
POOL="${INCUS_POOL:-local}"

READY_TRIES="${READY_TRIES:-20}"          # 20 x 3s = 60s ceiling
READY_INTERVAL="${READY_INTERVAL:-3}"

# The Incus project takes its name from `name:` in compose.yaml, NOT from the
# directory. Falling back to the directory name is a guess and may be wrong.
detect_project() {
  local n=""
  [[ -f "$COMPOSE_FILE" ]] && n="$(grep -E '^name:' "$COMPOSE_FILE" | head -1 | sed 's/^name:[[:space:]]*//; s/[[:space:]]*$//')"
  echo "${n:-$(basename "$STACK_DIR")}"
}
PROJECT="${INCUS_PROJECT:-$(detect_project)}"

# Sets REPO, TAG_RE, ENV_VAR, VOLUME, VERSION_ARGS for the given service.
# The one trap worth stating loudly: syncthing's VOLUME is its own config
# volume, never the shared scratch volume. Scratch is disposable by design
# and will be the largest thing in the deployment — snapshotting it on
# every update would be backwards.
service_config() {
  case "$1" in
    hermes)
      REPO="nousresearch/hermes-agent"
      # v-prefixed CalVer with an optional revision: v2026.7.30, v2026.7.7.2.
      TAG_RE='^v[0-9]{4}\.[0-9]{1,2}\.[0-9]{1,2}(\.[0-9]+)?$'
      ENV_VAR="HERMES_TAG"
      VOLUME="${HERMES_VOLUME:-vol-hermes-data}"
      VERSION_ARGS=(hermes version)
      ;;
    syncthing)
      REPO="syncthing/syncthing"
      # Strict three-part semver only. Upstream also publishes latest, edge,
      # rc, and rolling major/minor aliases (1, 1.29) — all excluded on
      # purpose, same hygiene as hermes's TAG_RE.
      TAG_RE='^[0-9]+\.[0-9]+\.[0-9]+$'
      ENV_VAR="SYNCTHING_TAG"
      VOLUME="${SYNCTHING_VOLUME:-vol-syncthing-config}"
      VERSION_ARGS=(syncthing --version)
      ;;
    *)
      die "unknown service '$1' — known: ${KNOWN_SERVICES[*]}"
      ;;
  esac
}

preflight() {
  if ! incus --project "$PROJECT" storage volume show "$POOL" "$VOLUME" >/dev/null 2>&1; then
    echo "cannot find volume '${VOLUME}' on pool '${POOL}' in project '${PROJECT}'" >&2
    echo >&2
    incus --project "$PROJECT" storage volume list "$POOL" >&2 || true
    echo >&2
    die "set INCUS_POOL / HERMES_VOLUME / SYNCTHING_VOLUME / INCUS_PROJECT to match"
  fi
}

version_of() {
  ( cd "$STACK_DIR" && incus-compose exec "$1" -- "${VERSION_ARGS[@]}" 2>/dev/null ) || true
}

current_tag() {
  grep -E "^${ENV_VAR}=" "$ENV_FILE" | head -1 | cut -d= -f2- || true
}

# Fetching and filtering are deliberately separate. Combined in one pipeline
# under `pipefail`, a non-matching grep exits 1 and is indistinguishable from a
# network failure — so an upstream tag-scheme change would be misreported as a
# connectivity problem.
fetch_tags() {
  curl -fsSL "https://hub.docker.com/v2/repositories/${REPO}/tags?page_size=100&ordering=last_updated" \
    | jq -r '.results[].name'
}

newest_tag() {
  printf '%s\n' "$1" | { grep -E "$TAG_RE" || true; } | sort -V | tail -1
}

cmd_check_one() {
  local svc="$1" cur tags new
  service_config "$svc"
  cur="$(current_tag)"
  if [[ -z "$cur" ]]; then
    echo "== ${svc}: no ${ENV_VAR} in ${ENV_FILE} — skipping"
    return 0
  fi

  echo "== ${svc}"
  tags="$(fetch_tags)" || die "could not reach the registry for ${svc}"
  new="$(newest_tag "$tags")"

  if [[ -z "$new" ]]; then
    echo "no tags matched ${TAG_RE}" >&2
    echo "upstream may have changed its versioning scheme. Saw:" >&2
    printf '%s\n' "$tags" | head -8 | sed 's/^/  /' >&2
    die "update TAG_RE for ${svc} in stack"
  fi

  printf 'current: %s\nlatest:  %s\n' "$cur" "$new"
  if [[ "$cur" == "$new" ]]; then
    echo "up to date"
  else
    printf 'apply:     stack update %s %s\n' "$svc" "$new"
  fi
  echo
}

cmd_check() {
  if [[ -n "${1:-}" ]]; then
    cmd_check_one "$1"
  else
    for svc in "${KNOWN_SERVICES[@]}"; do
      cmd_check_one "$svc"
    done
  fi
}

cmd_update() {
  local svc="${1:-}" new="${2:-}" cur snap before after
  [[ -n "$svc" && -n "$new" ]] || die "usage: stack update <service> <tag>"
  service_config "$svc"
  cur="$(current_tag)"
  [[ -n "$cur" ]] || die "no ${ENV_VAR} in ${ENV_FILE}"
  [[ "$cur" == "$new" ]] && { echo "already on $new"; return 0; }

  preflight

  # The image tag scheme and the app's own reported version never match
  # (hermes: CalVer tag vs semver app version; syncthing: they happen to be
  # close but are not guaranteed to track), so verification compares the
  # app version before and after rather than against the tag.
  before="$(version_of "$svc")"

  snap="pre-${new}-$(date +%Y%m%d%H%M)"
  echo "==> snapshotting ${PROJECT}:${POOL}/${VOLUME} as ${snap}"
  # `snapshot create` — the bare `snapshot <pool> <vol> <name>` shorthand
  # errors as an unknown command on this Incus version. Confirmed live.
  incus --project "$PROJECT" storage volume snapshot create "$POOL" "$VOLUME" "$snap"

  echo "==> pinning ${cur} -> ${new}"
  sed -i "s|^${ENV_VAR}=.*|${ENV_VAR}=${new}|" "$ENV_FILE"

  # incus-compose `ensure` checks that the instance EXISTS, not that it matches
  # the image — `up --pull always` alone refreshes the cache but leaves a
  # running instance on the old image, SILENTLY. --recreate deletes it first.
  # Custom volumes are untouched, so the service's own data survives.
  #
  # --recreate <service> is confirmed to scope per-service, not stack-wide:
  # recreating hermes left a running syncthing sidecar's uptime completely
  # undisturbed (2026-08-02). Not an assumption anymore.
  echo "==> pulling and recreating"
  ( cd "$STACK_DIR" && incus-compose up -d --recreate --pull always "$svc" )

  echo "==> waiting for readiness"
  after=""
  for _ in $(seq 1 "$READY_TRIES"); do
    sleep "$READY_INTERVAL"
    after="$(version_of "$svc")"
    [[ -n "$after" && "$after" != "$before" ]] && break
    printf '.'
  done
  echo

  ( cd "$STACK_DIR" && incus-compose ps )

  if [[ -z "$after" || "$after" == "$before" ]]; then
    echo
    echo "!! verification failed after $((READY_TRIES * READY_INTERVAL))s"
    echo "   before: ${before:-<none>}"
    echo "   after:  ${after:-<no output>}"
    echo "   identical output usually means the instance was not recreated."
    echo "   (false alarm if two tags ship the same app version — check by hand)"
    echo "   logs:       incus --project ${PROJECT} console ${svc}-1 --show-log"
    echo "   roll back:  stack update ${svc} ${cur}"
    echo "   or restore: incus --project ${PROJECT} storage volume restore ${POOL} ${VOLUME} ${snap}"
    exit 1
  fi
  echo "    ${before:-<none>}"
  echo " -> ${after}"

  # Commit but never push. Auto-pushing adds auth prompts, rejected pushes and
  # branch-protection failures to a run that just succeeded. Unpushed pins do
  # drift between machines though, so say so rather than stay silent.
  if git -C "$STACK_DIR" commit -q -m "${svc}: ${cur} -> ${new}" -- "$ENV_FILE" 2>/dev/null; then
    echo "==> pinned and committed (not pushed)"
    if git -C "$STACK_DIR" remote | grep -q .; then
      echo "    push when ready: git -C ${STACK_DIR} push"
    fi
  else
    echo "==> pinned (not committed — no repo, or nothing to commit)"
  fi

  echo "==> done. rollback: stack update ${svc} ${cur}"
}

case "${1:-check}" in
  check)  shift; cmd_check "${1:-}" ;;
  update) shift; cmd_update "${1:-}" "${2:-}" ;;
  *)      die "usage: stack {check [service] | update <service> <tag>}" ;;
esac
